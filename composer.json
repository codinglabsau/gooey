{
    "name": "codinglabsau/gooey",
    "description": "Laravel companion for the gooey Vue component library: flash toasts to Inertia from anywhere.",
    "keywords": [
        "laravel",
        "inertia",
        "toast",
        "flash",
        "gooey"
    ],
    "homepage": "https://github.com/codinglabsau/gooey",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^3.8"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Codinglabs\\Gooey\\": "laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codinglabs\\Gooey\\Tests\\": "laravel/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codinglabs\\Gooey\\GooeyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --test-directory=laravel/tests",
        "format": "pint laravel"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
